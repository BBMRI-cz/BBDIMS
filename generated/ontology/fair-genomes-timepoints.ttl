@prefix fg: <https://w3id.org/fair-genomes/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sio: <https://semanticscience.org/resource/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ordo: <http://www.orpha.net/ORDO/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

fg:Clinical_Clinical_timepoint_Baseline a obo:NCIT_C25213;
  rdfs:label "Baseline";
  dc:description "Initial assessment or sampling performed at the time of primary diagnosis prior to any treatment";
  rdfs:isDefinedBy obo:NCIT_C25213 .

fg:Clinical_Clinical_timepoint_Pre-treatment a obo:NCIT_C25213;
  rdfs:label "Pre-treatment";
  dc:description "Assessment or sample collection performed immediately before initiating a specific therapeutic regimen";
  rdfs:isDefinedBy obo:NCIT_C160920 .

fg:Clinical_Clinical_timepoint_Post-treatment a obo:NCIT_C25213;
  rdfs:label "Post-treatment";
  dc:description "Assessment or sample collection performed after completing or during a specific treatment interval";
  rdfs:isDefinedBy obo:NCIT_C160921 .

fg:Clinical_Clinical_timepoint_Interim a obo:NCIT_C25213;
  rdfs:label "Interim";
  dc:description "Mid-treatment assessment performed to evaluate early therapeutic response or toxicity";
  rdfs:isDefinedBy obo:NCIT_C156557 .

fg:Clinical_Clinical_timepoint_Follow-up a obo:NCIT_C25213;
  rdfs:label "Follow-up";
  dc:description "Routine monitoring assessment performed at defined intervals during the post-treatment period";
  rdfs:isDefinedBy obo:NCIT_C16033 .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Relapse_/_Progression>
  a obo:NCIT_C25213;
  rdfs:label "Relapse / Progression";
  dc:description "Assessment or sampling performed upon clinical, radiological, or molecular disease recurrence or progression";
  rdfs:isDefinedBy obo:NCIT_C15681 .

fg:Clinical_Clinical_timepoint_Day_0 a obo:NCIT_C25213;
  rdfs:label "Day 0";
  dc:description "The baseline reference day, typically marking the start of treatment or trial enrollment";
  rdfs:isDefinedBy obo:NCIT_C142664 .

fg:Clinical_Clinical_timepoint_Month_3 a obo:NCIT_C25213;
  rdfs:label "Month 3";
  dc:description "Assessment performed approximately 3 months after baseline or treatment initiation";
  rdfs:isDefinedBy obo:NCIT_C142669 .

fg:Clinical_Clinical_timepoint_Month_6 a obo:NCIT_C25213;
  rdfs:label "Month 6";
  dc:description "Assessment performed approximately 6 months after baseline or treatment initiation";
  rdfs:isDefinedBy obo:NCIT_C142670 .

fg:Clinical_Clinical_timepoint_Year_1 a obo:NCIT_C25213;
  rdfs:label "Year 1";
  dc:description "Assessment performed approximately 1 year after baseline or treatment initiation";
  rdfs:isDefinedBy obo:NCIT_C142672 .

fg:Clinical_Clinical_timepoint_End_of_study a obo:NCIT_C25213;
  rdfs:label "End of study";
  dc:description "Final clinical evaluation or sampling at the completion of a patient's participation in a study or protocol";
  rdfs:isDefinedBy obo:NCIT_C142698 .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_NoInformation_(NI,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "NoInformation (NI, nullflavor)";
  dc:description "The value is exceptional (missing, omitted, incomplete, improper). No information as to the reason for being an exceptional value is provided. This is the most general exceptional value. It is also the default exceptional value.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NI> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Invalid_(INV,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Invalid (INV, nullflavor)";
  dc:description "The value as represented in the instance is not a member of the set of permitted data values in the constrained value domain of a variable.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#INV> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Derived_(DER,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Derived (DER, nullflavor)";
  dc:description "An actual value may exist, but it must be derived from the provided information (usually an EXPR generic data type extension will be used to convey the derivation expression .";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#DER> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Other_(OTH,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Other (OTH, nullflavor)";
  dc:description "The actual value is not a member of the set of permitted data values in the constrained value domain of a variable.The actual value is not a member of the set of permitted data values in the constrained value domain of a variable. (e.g., concept not provided by required code system).";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#OTH> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Negative_infinity_(NINF,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Negative infinity (NINF, nullflavor)";
  dc:description "Negative infinity of numbers.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NINF> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Positive_infinity_(PINF,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Positive infinity (PINF, nullflavor)";
  dc:description "Positive infinity of numbers.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#PINF> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Un-encoded_(UNC,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Un-encoded (UNC, nullflavor)";
  dc:description "The actual value has not yet been encoded within the approved value domain.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#UNC> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Masked_(MSK,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Masked (MSK, nullflavor)";
  dc:description "There is information on this item available but it has not been provided by the sender due to security, privacy or other reasons. There may be an alternate mechanism for gaining access to this information.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#MSK> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Not_applicable_(NA,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Not applicable (NA, nullflavor)";
  dc:description "Known to have no proper value (e.g., last menstrual period for a male).";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NA> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Unknown_(UNK,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Unknown (UNK, nullflavor)";
  dc:description "A proper value is applicable, but not known.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#UNK> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Asked_but_unknown_(ASKU,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Asked but unknown (ASKU, nullflavor)";
  dc:description "Information was sought but not found (e.g., patient was asked but didn't know)";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#ASKU> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Temporarily_unavailable_(NAV,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Temporarily unavailable (NAV, nullflavor)";
  dc:description "Information is not available at this time but it is expected that it will be available later.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NAV> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Not_asked_(NASK,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Not asked (NASK, nullflavor)";
  dc:description "This information has not been sought. (e.g., patient was not asked)";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NASK> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Not_available_(NAVU,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Not available (NAVU, nullflavor)";
  dc:description "Information is not available at this time (with no expectation regarding whether it will or will not be available in the future).";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NAVU> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Sufficient_quantity_(QS,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Sufficient quantity (QS, nullflavor)";
  dc:description "The specific quantity is not known, but is known to be non-zero and is not specified because it makes up the bulk of the material. e.g. 'Add 10mg of ingredient X, 50mg of ingredient Y, and sufficient quantity of water to 100mL.' The null flavor would be used to express the quantity of water.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#QS> .

<https://w3id.org/fair-genomes/ontology/Clinical_Clinical_timepoint_Trace_(TRC,_nullflavor)>
  a obo:NCIT_C25213;
  rdfs:label "Trace (TRC, nullflavor)";
  dc:description "The content is greater than zero, but too small to be quantified.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#TRC> .
