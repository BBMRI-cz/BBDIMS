@prefix fg: <https://w3id.org/fair-genomes/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sio: <https://semanticscience.org/resource/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ordo: <http://www.orpha.net/ORDO/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

fg:Clinical_Disease_stage_Stage_0 a obo:NCIT_C16899;
  rdfs:label "Stage 0";
  dc:description "Carcinoma in situ or pre-invasive disease with no evidence of regional lymph node involvement or distant metastasis";
  rdfs:isDefinedBy obo:NCIT_C27967 .

fg:Clinical_Disease_stage_Stage_I a obo:NCIT_C16899;
  rdfs:label "Stage I";
  dc:description "Early-stage disease characterised by a localized primary tumor without lymph node involvement or distant metastasis";
  rdfs:isDefinedBy obo:NCIT_C27966 .

fg:Clinical_Disease_stage_Stage_II a obo:NCIT_C16899;
  rdfs:label "Stage II";
  dc:description "Locally invasive disease with larger tumor size or limited regional lymph node involvement";
  rdfs:isDefinedBy obo:NCIT_C28054 .

fg:Clinical_Disease_stage_Stage_III a obo:NCIT_C16899;
  rdfs:label "Stage III";
  dc:description "Locally advanced disease characterised by extensive regional tumor spread or extensive lymph node involvement";
  rdfs:isDefinedBy obo:NCIT_C27970 .

fg:Clinical_Disease_stage_Stage_IV a obo:NCIT_C16899;
  rdfs:label "Stage IV";
  dc:description "Advanced disease characterised by distant metastasis beyond the primary organ or regional lymph nodes";
  rdfs:isDefinedBy obo:NCIT_C27971 .

fg:Clinical_Disease_stage_Localised a obo:NCIT_C16899;
  rdfs:label "Localised";
  dc:description "Disease confined entirely to the organ of origin without spread to regional lymph nodes or distant sites";
  rdfs:isDefinedBy obo:NCIT_C38134 .

fg:Clinical_Disease_stage_Regional a obo:NCIT_C16899;
  rdfs:label "Regional";
  dc:description "Disease that has spread beyond the primary site to adjacent tissue or regional lymph nodes";
  rdfs:isDefinedBy obo:NCIT_C38135 .

fg:Clinical_Disease_stage_Metastatic a obo:NCIT_C16899;
  rdfs:label "Metastatic";
  dc:description "Disease that has spread to distant organs, anatomical regions, or distant lymph nodes";
  rdfs:isDefinedBy obo:NCIT_C19151 .

fg:Clinical_Disease_stage_Early_stage a obo:NCIT_C16899;
  rdfs:label "Early stage";
  dc:description "Broad categorisation for disease in its initial phases, typically encompassing Stages 0 through II";
  rdfs:isDefinedBy obo:NCIT_C85623 .

fg:Clinical_Disease_stage_Advanced_stage a obo:NCIT_C16899;
  rdfs:label "Advanced stage";
  dc:description "Broad categorisation for disease that has progressed significantly, typically encompassing Stages III and IV";
  rdfs:isDefinedBy obo:NCIT_C85624 .

fg:Clinical_Disease_stage_Recurrent a obo:NCIT_C16899;
  rdfs:label "Recurrent";
  dc:description "Reappearance of disease after a period of remission or complete therapeutic response";
  rdfs:isDefinedBy obo:NCIT_C38155 .

fg:Clinical_Disease_stage_Unknown a obo:NCIT_C16899;
  rdfs:label "Unknown";
  dc:description "Disease stage cannot be assessed or is not documented in the clinical record";
  rdfs:isDefinedBy obo:NCIT_C17998 .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_NoInformation_(NI,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "NoInformation (NI, nullflavor)";
  dc:description "The value is exceptional (missing, omitted, incomplete, improper). No information as to the reason for being an exceptional value is provided. This is the most general exceptional value. It is also the default exceptional value.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NI> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Invalid_(INV,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Invalid (INV, nullflavor)";
  dc:description "The value as represented in the instance is not a member of the set of permitted data values in the constrained value domain of a variable.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#INV> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Derived_(DER,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Derived (DER, nullflavor)";
  dc:description "An actual value may exist, but it must be derived from the provided information (usually an EXPR generic data type extension will be used to convey the derivation expression .";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#DER> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Other_(OTH,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Other (OTH, nullflavor)";
  dc:description "The actual value is not a member of the set of permitted data values in the constrained value domain of a variable.The actual value is not a member of the set of permitted data values in the constrained value domain of a variable. (e.g., concept not provided by required code system).";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#OTH> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Negative_infinity_(NINF,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Negative infinity (NINF, nullflavor)";
  dc:description "Negative infinity of numbers.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NINF> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Positive_infinity_(PINF,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Positive infinity (PINF, nullflavor)";
  dc:description "Positive infinity of numbers.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#PINF> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Un-encoded_(UNC,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Un-encoded (UNC, nullflavor)";
  dc:description "The actual value has not yet been encoded within the approved value domain.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#UNC> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Masked_(MSK,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Masked (MSK, nullflavor)";
  dc:description "There is information on this item available but it has not been provided by the sender due to security, privacy or other reasons. There may be an alternate mechanism for gaining access to this information.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#MSK> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Not_applicable_(NA,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Not applicable (NA, nullflavor)";
  dc:description "Known to have no proper value (e.g., last menstrual period for a male).";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NA> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Unknown_(UNK,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Unknown (UNK, nullflavor)";
  dc:description "A proper value is applicable, but not known.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#UNK> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Asked_but_unknown_(ASKU,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Asked but unknown (ASKU, nullflavor)";
  dc:description "Information was sought but not found (e.g., patient was asked but didn't know)";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#ASKU> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Temporarily_unavailable_(NAV,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Temporarily unavailable (NAV, nullflavor)";
  dc:description "Information is not available at this time but it is expected that it will be available later.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NAV> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Not_asked_(NASK,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Not asked (NASK, nullflavor)";
  dc:description "This information has not been sought. (e.g., patient was not asked)";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NASK> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Not_available_(NAVU,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Not available (NAVU, nullflavor)";
  dc:description "Information is not available at this time (with no expectation regarding whether it will or will not be available in the future).";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NAVU> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Sufficient_quantity_(QS,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Sufficient quantity (QS, nullflavor)";
  dc:description "The specific quantity is not known, but is known to be non-zero and is not specified because it makes up the bulk of the material. e.g. 'Add 10mg of ingredient X, 50mg of ingredient Y, and sufficient quantity of water to 100mL.' The null flavor would be used to express the quantity of water.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#QS> .

<https://w3id.org/fair-genomes/ontology/Clinical_Disease_stage_Trace_(TRC,_nullflavor)>
  a obo:NCIT_C16899;
  rdfs:label "Trace (TRC, nullflavor)";
  dc:description "The content is greater than zero, but too small to be quantified.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#TRC> .
