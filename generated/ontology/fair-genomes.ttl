<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Software_version>
  a owl:ObjectProperty;
  rdfs:label "Software version";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C111093;
  dc:description "A form or variant of software; one of a sequence of copies of a software program, each incorporating new modifications.";
  rdfs:range <http://snomed.info/id/706687001> .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Color_space> a owl:ObjectProperty;
  rdfs:label "Color space";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C37927;
  dc:description "The photometric interpretation of pixel data that defines the type of colour or greyscale encoding used in the image (e.g., MONOCHROME2, RGB, YBR_FULL). Corresponds to DICOM tag (0028,0004).";
  rdfs:range <https://w3id.org/valuesets/ColorSpaceEnum> .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Pixel_spacing> a owl:DatatypeProperty;
  rdfs:label "Pixel spacing";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C45786;
  dc:description "Physical distance between the centres of adjacent pixels in the image space, specified as row and column spacing. Expressed in millimetres (mm) according to DICOM attribute (0028,0030)." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Image_type> a owl:ObjectProperty;
  rdfs:label "Image type";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C69268;
  dc:description "A classification of the image based on the imaging modality and acquisition characteristics. It specifies the type of image produced during the scan (e.g., T1-weighted MRI, T2-weighted MRI, CT attenuation image, PET uptake image).";
  rdfs:range <http://snomed.info/id/363679005> .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_File_format> a owl:ObjectProperty;
  rdfs:label "File format";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:MS_1001459;
  dc:description "The digital format used to encode and store an imaging file.";
  rdfs:range obo:MS_1001459 .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_File_size> a owl:DatatypeProperty;
  rdfs:label "File size";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C171192;
  dc:description "The size of the file in MB." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Image_width> a owl:DatatypeProperty;
  rdfs:label "Image width";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002468>;
  dc:description "Number of pixels in one row of the image, corresponding to the DICOM attribute Columns (0028,0011)." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Image_height> a owl:DatatypeProperty;
  rdfs:label "Image height";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002467>;
  dc:description "Number of pixels in one column of the image, corresponding to the DICOM attribute Rows (0028,0010)." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Image_depth> a owl:DatatypeProperty;
  rdfs:label "Image depth";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C69267;
  dc:description "The number of distinct image planes captured during acquisition. For WSI, this represents the number of focal planes (Z-stack levels). For CT, MRI, and PET, it corresponds to the number of cross-sectional slices or frames. For DX and MG, this value is typically 1 (a single 2D projection)." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Number_of_channels>
  a owl:DatatypeProperty;
  rdfs:label "Number of channels";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#SamplesPerPixel>;
  dc:description "The number of distinct data channels stored in each pixel of the image. Channels may represent color components (e.g., RGB), grayscale intensity, or modality-specific signal dimensions." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Channel_resolution>
  a owl:DatatypeProperty;
  rdfs:label "Channel resolution";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#SignificantBits>;
  dc:description "The number of bits used to represent the stored value of each pixel channel. In DICOM, this corresponds to tag (0028,0101)." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Compression_method>
  a owl:DatatypeProperty;
  rdfs:label "Compression method";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C64347;
  dc:description "Indicates whether the image was lossy-compressed and which method was used, based on DICOM tags (0028,2110) and (0028,2114)." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Annotations_available>
  a owl:DatatypeProperty;
  rdfs:label "Annotations available";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C44272;
  dc:description "Indicates whether annotation data associated with the image (e.g., regions of interest, labels, markup, or segmentation overlays) are present and accessible." .

