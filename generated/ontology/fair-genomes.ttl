  rdfs:isDefinedBy obo:NCIT_C17369;
  dc:description "Any technology or method that aids in the visualization of any biological process, cell, tissue or organ for use in screening, diagnosis, surgical procedures or therapy.";
  rdfs:range <http://purl.bioontology.org/ontology/SNOMEDCT/360037004> .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Series_date> a owl:DatatypeProperty;
  rdfs:label "Series date";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C68616;
  dc:description "The date on which a series began." .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Body_region> a owl:ObjectProperty;
  rdfs:label "Body region";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C12680;
  dc:description "The specific anatomical region, body part, or organ targeted by this imaging series.";
  rdfs:range <http://snomed.info/id/52530000> .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Laterality> a owl:ObjectProperty;
  rdfs:label "Laterality";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C25185;
  dc:description "The side of the body or paired organ being examined (e.g. Left, Right, Bilateral, Unilateral).";
  rdfs:range <http://snomed.info/id/106233006> .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Imaging_device> a
    owl:ObjectProperty;
  rdfs:label "Imaging device";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C19747;
  dc:description "A device for producing a representation or picture, usually of a part of the body, to aid in diagnosis and evaluation.";
  rdfs:range <http://snomed.info/id/314789007> .

<https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)_Manufacturer_of_imaging_device>
  a owl:ObjectProperty;
  rdfs:label "Manufacturer of imaging device";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Ultrasound_Imaging_(US)>;
  rdfs:isDefinedBy obo:NCIT_C25392;
  dc:description "A person, enterprise, or entity that produces imaging device.";
