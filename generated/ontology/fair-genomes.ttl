  rdfs:range obo:MS_1001459 .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_File_size> a owl:DatatypeProperty;
  rdfs:label "File size";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C171192;
  dc:description "The size of the file in MB." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Image_width> a owl:DatatypeProperty;
  rdfs:label "Image width";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002468>;
  dc:description "Number of pixels in one row of the image, corresponding to the DICOM attribute Columns (0028,0011)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Image_height> a owl:DatatypeProperty;
  rdfs:label "Image height";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002467>;
  dc:description "Number of pixels in one column of the image, corresponding to the DICOM attribute Rows (0028,0010)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Image_depth> a owl:DatatypeProperty;
  rdfs:label "Image depth";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C69267;
  dc:description "The number of distinct image planes captured during acquisition. For WSI, this represents the number of focal planes (Z-stack levels). For CT, MRI, and PET, it corresponds to the number of cross-sectional slices or frames. For DX and MG, this value is typically 1 (a single 2D projection)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Number_of_channels>
  a owl:DatatypeProperty;
  rdfs:label "Number of channels";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#SamplesPerPixel>;
  dc:description "The number of distinct data channels stored in each pixel of the image. Channels may represent color components (e.g., RGB), grayscale intensity, or modality-specific signal dimensions." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Channel_resolution>
  a owl:DatatypeProperty;
  rdfs:label "Channel resolution";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#SignificantBits>;
  dc:description "The number of bits used to represent the stored value of each pixel channel. In DICOM, this corresponds to tag (0028,0101)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Compression_method>
  a owl:DatatypeProperty;
  rdfs:label "Compression method";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C64347;
  dc:description "Indicates whether the image was lossy-compressed and which method was used, based on DICOM tags (0028,2110) and (0028,2114)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Annotations_available>
  a owl:DatatypeProperty;
  rdfs:label "Annotations available";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C44272;
  dc:description "Indicates whether annotation data associated with the image (e.g., regions of interest, labels, markup, or segmentation overlays) are present and accessible." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)> a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C16809;
  rdfs:label "Magnetic resonance (MR)";
  dc:description "Modality-specific series metadata for magnetic resonance imaging acquisitions, capturing static magnetic field strength, radiofrequency pulse sequence timing (TR/TE), flip angle, and receive coil configurations." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_MR_identifier> a owl:DatatypeProperty;
  rdfs:label "MR identifier";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:NCIT_C69219;
  dc:description "A unique identifier for MR series of images." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Sequence_name> a owl:DatatypeProperty;
  rdfs:label "Sequence name";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:NCIT_C164586;
  dc:description "The literal identifier for the pulse sequence. Corresponds to DICOM tag (0018,0024)." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Magnetic_field_strength>
  a owl:DatatypeProperty;
  rdfs:label "Magnetic field strength";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:NCIT_C156494;
  dc:description "A measurement of the strength of the static magnetic field (B₀) generated by an MRI system, expressed in units of Tesla (T). Corresponds to DICOM tag (0018,0087)." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Repetition_time> a
    owl:DatatypeProperty;
  rdfs:label "Repetition time";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:NCIT_C82330;
  dc:description "The amount of time in milliseconds (ms) between successive pulse sequences applied to the same slice. Corresponds to DICOM tag (0018,0080)." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Echo_time> a owl:DatatypeProperty;
  rdfs:label "Echo time";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:NCIT_C82331;
  dc:description "The time in milliseconds between the application of the excitation pulse and the recording of the peak echo signal. Corresponds to DICOM tag (0018,0081)." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Imaging_frequency>
  a owl:DatatypeProperty;
  rdfs:label "Imaging frequency";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:UO_0000105;
  dc:description "The Larmor resonance frequency used during MR data acquisition, determined by the strength of the static magnetic field (B₀) and expressed in megahertz (MHz). Corresponds to DICOM tag (0018,0084)." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Flip_angle> a owl:DatatypeProperty;
  rdfs:label "Flip angle";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:UO_0000122;
  dc:description "In magnetic resonance imaging, the angle by which the net magnetization vector is rotated away from the main magnetic field (B₀) by an applied radiofrequency pulse. It is expressed in degrees (°). Corresponds to DICOM tag (0018,1314)." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Inversion_time> a
    owl:DatatypeProperty;
  rdfs:label "Inversion time";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:NCIT_C116124;
  dc:description "The time between the inversion and excitation pulses in an inversion recovery pulse sequence, expressed in milliseconds (ms). Corresponds to DICOM tag (0018,0082)." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Receive_coil_name>
  a owl:DatatypeProperty;
  rdfs:label "Receive coil name";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy <http://www.radlex.org/RID/RID10830>;
  dc:description "The designated name of the radiofrequency (RF) receive coil used during MR acquisition, identifying the specific hardware component that detects the MR signal. Corresponds to DICOM tag (0018,1250)." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Field_of_view> a owl:DatatypeProperty;
  rdfs:label "Field of view";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:NCIT_C74298;
  dc:description "The physical size of the anatomical region covered in the reconstructed image, expressed in millimetres." .

<https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)_Slice_thickness> a
