@prefix fg: <https://w3id.org/fair-genomes/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sio: <https://semanticscience.org/resource/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ordo: <http://www.orpha.net/ORDO/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/fair-genomes/ontology/> a owl:Ontology;
  dc:title "Biobank Biosample and Data Integration Metadata Schema";
  dc:description "The Biobank Biosample and Data Integration Metadata Schema extends the MOLGENIS FAIR Genomes framework to standardise how biobank catalogues describe biological samples and their associated large-scale datasets. It links donor profiles, consent, and biospecimen records directly to multi-omics and imaging data using established ontologies. This structured approach facilitates seamless sample discovery, data harmonisation, and metadata exchange across biobank networks.";
  dc:date "2026-10-15";
  owl:versionInfo "1.1-SNAPSHOT";
  dc:language "en";
  dc:rights "This ontology is distributed under a Attribution 4.0 International (CC BY 4.0) License - https://creativecommons.org/licenses/by/4.0/. Copyright: University Medical Center Groningen (2026).";
  dc:publisher <https://github.com/fairgenomes/fairgenomes-semantic-model>;
  <http://purl.org/dc/terms/license> "Attribution 4.0 International (CC BY 4.0)";
  <http://purl.org/dc/terms/LicenseDocument> <https://creativecommons.org/licenses/by/4.0/>;
  dc:creator "Radoslava Kacová <radoslava.kacova@mou.cz>", <https://orcid.org/0009-0008-1429-6988>,
    "K. Joeri van der Velde <k.j.van.der.velde@umcg.nl>", <https://orcid.org/0000-0002-0934-8375>,
    "Morris A. Swertz <m.a.swertz@umcg.nl>", <https://orcid.org/0000-0002-0979-3401> .

fg:Study a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C63536;
  rdfs:label "Study";
  dc:description "A research study, trial, or project context under which biological samples and associated datasets are collected, grouped, and managed for specific research objectives." .

fg:Study_Identifier a owl:DatatypeProperty;
  rdfs:label "Identifier";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:OMIABIS_0000006;
  dc:description "A unique character string or persistent identifier that unambiguously distinguishes this study." .

fg:Study_Name a owl:DatatypeProperty;
  rdfs:label "Name";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:OMIABIS_0000037;
  dc:description "The official title, full name, or public label designating this study or research project." .

fg:Study_Description a owl:DatatypeProperty;
  rdfs:label "Description";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:OMIABIS_0000036;
  dc:description "A narrative summary outlining the scientific background, main objectives, and overall scope of the study." .

fg:Study_Study_URL a owl:DatatypeProperty;
  rdfs:label "Study URL";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:NCIT_C42743;
  dc:description "A resolvable web address, digital object identifier (DOI) link, or persistent public repository URL pointing to the study documentation, trial registration, or associated online publication." .

fg:Study_Inclusion_criteria a owl:ObjectProperty;
  rdfs:label "Inclusion criteria";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:OBI_0500027;
  dc:description "The primary medical, demographic, or genetic eligibility criteria required for a participant to be enrolled in this study.";
  rdfs:range obo:OBI_0500027 .

fg:Study_Principal_investigator a owl:DatatypeProperty;
  rdfs:label "Principal investigator";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:OMIABIS_0000100;
  dc:description "The primary scientific leader, lead researcher, or designated contact person responsible for the design, execution, and integrity of the study." .

fg:Study_Contact_information a owl:DatatypeProperty;
  rdfs:label "Contact information";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:OMIABIS_0000035;
  dc:description "An email address for the purpose of contacting the study contact person." .

fg:Study_Study_design a owl:DatatypeProperty;
  rdfs:label "Study design";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:OBI_0500000;
  dc:description "The methodological framework and operational protocol specification describing how subjects, biospecimens, and data are structured and collected (e.g. cohort, case-control, longitudinal, cross-sectional)." .

fg:Study_Start_date a owl:DatatypeProperty;
  rdfs:label "Start date";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:NCIT_C69208;
  dc:description "The date on which this study began." .

fg:Study_Completion_date a owl:DatatypeProperty;
  rdfs:label "Completion date";
  rdfs:domain fg:Study;
  rdfs:isDefinedBy obo:NCIT_C142702;
  dc:description "The date on which all study protocols are finalized, participant follow-ups conclude, or the primary research objectives are fully met." .

fg:Personal a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C90492;
  rdfs:label "Personal";
  dc:description "Demographic, phenotypic, and baseline characteristics of an individual study participant or patient from whom biological materials and associated research data are collected.";
  obo:RO_0000056 fg:Study;
  obo:ICO_0000005 fg:Individual_consent .

fg:Personal_Personal_identifier a owl:DatatypeProperty;
  rdfs:label "Personal identifier";
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:NCIT_C164337;
  dc:description "A unique pseudonymised code or persistent subject identifier assigned to an individual within the study or biobank repository." .

fg:Personal_Gender_at_birth a owl:ObjectProperty;
  rdfs:label "Gender at birth";
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:GSSO_009418;
  dc:description "The gender or biological sex assigned to the individual at birth, typically documented in medical records or official birth certificates.";
  rdfs:range obo:GSSO_009418 .

fg:Personal_Country_of_residence a owl:ObjectProperty;
  rdfs:label "Country of residence";
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:NCIT_C224826;
  dc:description "The sovereign country where the individual primarily resides at the time of study enrolment or sample collection.";
  rdfs:range obo:GENEPIO_0001830 .

fg:Personal_Ancestry a owl:ObjectProperty;
  rdfs:label "Ancestry";
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:NCIT_C176763;
  dc:description "The genetic or geographic ancestral background of an individual, evaluated using ancestry-informative genomic markers or population categories.";
  rdfs:range obo:HANCESTRO_0004 .

fg:Personal_Country_of_birth a owl:ObjectProperty;
  rdfs:label "Country of birth";
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:GENEPIO_0001094;
  dc:description "The country in which the individual was born.";
  rdfs:range obo:GENEPIO_0001830 .

fg:Personal_Year_of_birth a owl:DatatypeProperty;
  rdfs:label "Year of birth";
  sio:SIO_000074 obo:NCIT_C159612;
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:NCIT_C83164;
  dc:description "The year in which the individual person was born." .

fg:Personal_Status a owl:ObjectProperty;
  rdfs:label "Status";
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:NCIT_C166244;
  dc:description "The most recent vital or clinical follow-up status of the individual recorded by the biobank or registry (e.g. alive, deceased, lost to follow-up).";
  rdfs:range obo:NCIT_C19332 .

fg:Personal_Age_at_death a owl:DatatypeProperty;
  rdfs:label "Age at death";
  sio:SIO_000074 obo:UO_0000036;
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:NCIT_C135383;
  dc:description "In the event of participant decease, the calculated age of the individual at the time of death, measured in completed years." .

fg:Personal_Primary_affiliated_institute a owl:ObjectProperty;
  rdfs:label "Primary affiliated institute";
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:NCIT_C25412;
  dc:description "The primary healthcare facility, clinical centre, or biobank institution responsible for the medical management or enrolment of the individual.";
  rdfs:range <http://semanticscience.org/resource/SIO_000688> .

fg:Personal_Participates_in_study a owl:ObjectProperty;
  rdfs:label "Participates in study";
  rdfs:domain fg:Personal;
  rdfs:isDefinedBy obo:RO_0000056;
  dc:description "Reference to the study or studies in which this person participates." .

fg:Leaflet_and_consent_form a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C16468;
  rdfs:label "Leaflet and consent form";
  dc:description "Specification and metadata of the informative leaflet and blank informed consent template version approved for a study or biobank collection." .

fg:Leaflet_and_consent_form_Consent_form_identifier a owl:DatatypeProperty;
  rdfs:label "Consent form identifier";
  rdfs:domain fg:Leaflet_and_consent_form;
  rdfs:isDefinedBy <http://purl.org/dc/terms/identifier>;
  dc:description "A unique persistent identifier, DOI, or resolvable URL unambiguously identifying this specific consent template and leaflet pair." .

fg:Leaflet_and_consent_form_Consent_form_title a owl:DatatypeProperty;
  rdfs:label "Consent form title";
  rdfs:domain fg:Leaflet_and_consent_form;
  rdfs:isDefinedBy <http://purl.org/dc/terms/title>;
  dc:description "The formal document title of the informed consent form template." .

fg:Leaflet_and_consent_form_Consent_form_creator a owl:ObjectProperty;
  rdfs:label "Consent form creator";
  rdfs:domain fg:Leaflet_and_consent_form;
  rdfs:isDefinedBy <http://purl.org/dc/terms/creator>;
  dc:description "The authoritative biobank institution, hospital, or governance board that authored and issued this consent form.";
  rdfs:range <http://semanticscience.org/resource/SIO_000688> .

fg:Leaflet_and_consent_form_Consent_form_version a owl:DatatypeProperty;
  rdfs:label "Consent form version";
  rdfs:domain fg:Leaflet_and_consent_form;
  rdfs:isDefinedBy <http://purl.org/dc/terms/hasVersion>;
  dc:description "The formal version number, release tag, or revision identifier of this consent form template." .

fg:Individual_consent a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C16735;
  rdfs:label "Individual consent";
  dc:description "Record of a signed informed consent given by an individual or legal guardian, specifying data and sample use permissions, restrictions, and validity periods.";
  obo:IAO_0021007 fg:Leaflet_and_consent_form;
  obo:IAO_0000136 fg:Study .

fg:Individual_consent_Individual_consent_identifier a owl:DatatypeProperty;
  rdfs:label "Individual consent identifier";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy obo:ICO_0000044;
  dc:description "A unique proper name or character sequence that identifies this particular signed individual consent." .

fg:Individual_consent_Person_consenting a owl:ObjectProperty;
  rdfs:label "Person consenting";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy <http://semanticscience.org/resource/SIO_000132>;
  dc:description "Reference to the person (i.e. subject) to whom this individual consent applies." .

fg:Individual_consent_Consent_form_used a owl:ObjectProperty;
  rdfs:label "Consent form used";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy <http://purl.org/dc/terms/conformsTo>;
  dc:description "Link to the specific approved template version in the Leaflet and consent form module used during signing." .

fg:Individual_consent_Belongs_to_study a owl:ObjectProperty;
  rdfs:label "Belongs to study";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy obo:IAO_0000136;
  dc:description "Reference to the study for which this individual consent permits data and sample use." .

fg:Individual_consent_Collected_by a owl:ObjectProperty;
  rdfs:label "Collected by";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy obo:NCIT_C45262;
  dc:description "The healthcare facility, clinical ward, or biobank site where the informed consent was administered and obtained.";
  rdfs:range <http://semanticscience.org/resource/SIO_000688> .

fg:Individual_consent_Signing_date a owl:DatatypeProperty;
  rdfs:label "Signing date";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy obo:ICO_0000036;
  dc:description "A date specification that designates when this individual consent form was signed." .

fg:Individual_consent_Valid_until a owl:DatatypeProperty;
  rdfs:label "Valid until";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy <http://purl.org/dc/terms/valid>;
  dc:description "The expiry date or termination date of the consent, such as upon participant withdrawal or completion of a time-limited study protocol." .

fg:Individual_consent_Represented_by a owl:ObjectProperty;
  rdfs:label "Represented by";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy obo:NCIT_C142600;
  dc:description "An individual who is authorized under applicable State or local law to consent on behalf of a child or incapable person to general medical care including participation in clinical research.";
  rdfs:range obo:BFO_0000023 .

fg:Individual_consent_Data_use_permissions a owl:ObjectProperty;
  rdfs:label "Data use permissions";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy obo:DUO_0000001;
  dc:description "The primary consented permission and intended scope governing the secondary research use of datasets and biological specimens.";
  rdfs:range obo:DUO_0000001 .

fg:Individual_consent_Data_use_modifiers a owl:ObjectProperty;
  rdfs:label "Data use modifiers";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy obo:DUO_0000017;
  dc:description "Data use modifiers indicate additional conditions for use. For instance, a dataset is restricted to investigations into specific diseases or performed at specific geographical locations.";
  rdfs:range obo:DUO_0000017 .

fg:Individual_consent_Allow_recontacting a owl:ObjectProperty;
  rdfs:label "Allow recontacting";
  rdfs:domain fg:Individual_consent;
  rdfs:isDefinedBy obo:NCIT_C25737;
  dc:description "Indication of whether the participant has consented to be re-contacted by the biobank or clinical team for study updates, further sample donations, or actionable secondary health findings.";
  rdfs:range obo:NCIT_C176244 .

fg:Clinical a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C25398;
  rdfs:label "Clinical";
  dc:description "Clinical observations, diagnoses, disease staging, and longitudinal treatment responses recorded for a patient across specific disease encounters or study timepoints.";
  <http://semanticscience.org/resource/SIO_000332> fg:Personal .

fg:Clinical_Clinical_identifier a owl:DatatypeProperty;
  rdfs:label "Clinical identifier";
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy obo:NCIT_C87853;
  dc:description "A unique proper name or character sequence that identifies this particular clinical examination." .

fg:Clinical_Belongs_to_person a owl:ObjectProperty;
  rdfs:label "Belongs to person";
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy obo:IAO_0000136;
  dc:description "Reference to the person whom this clinical information is about." .

fg:Clinical_Diagnosis a owl:ObjectProperty;
  rdfs:label "Diagnosis";
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy obo:NCIT_C15607;
  dc:description "Main clinical diagnosis coded using ICD-10, ORPHA, or SNOMED CT.";
  rdfs:range <http://edamontology.org/data_3667> .

fg:Clinical_Age_at_diagnosis a owl:DatatypeProperty;
  rdfs:label "Age at diagnosis";
  sio:SIO_000074 obo:UO_0000036;
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy <http://purl.bioontology.org/ontology/SNOMEDCT/423493009>;
  dc:description "Age of the patient in years at the time of disease diagnosis." .

fg:Clinical_Clinical_timepoint a owl:ObjectProperty;
  rdfs:label "Clinical timepoint";
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy obo:NCIT_C68568;
  dc:description "Relative timepoint or clinical phase of this encounter relative to diagnosis or baseline (e.g. Baseline, Post-treatment, Relapse, Day 0, Month 3).";
  rdfs:range obo:NCIT_C25213 .

fg:Clinical_Disease_stage a owl:ObjectProperty;
  rdfs:label "Disease stage";
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy obo:OBI_0000278;
  dc:description "Broad categorisation of disease progression at the time of data or sample collection (e.g. Stage I-IV, Early/Advanced, Primary/Metastatic).";
  rdfs:range obo:NCIT_C16899 .

fg:Clinical_Molecular_diagnosis_gene a owl:ObjectProperty;
  rdfs:label "Molecular diagnosis gene";
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy obo:NCIT_C20826;
  dc:description "Causal gene(s) bearing a confirmed pathogenic or clinically significant variant associated with the patient's diagnosis or response to treatment (e.g. BRCA1, EGFR, KRAS). Do not list all tested panel genes here.";
  rdfs:range obo:NCIT_C16612 .

fg:Clinical_Treatment_category a owl:ObjectProperty;
  rdfs:label "Treatment category";
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy obo:NCIT_C49236;
  dc:description "High-level classification of therapies applied to the patient (e.g. Chemotherapy, Radiotherapy, Immunotherapy, Surgery, Naive/Untreated).";
  rdfs:range obo:NCIT_C49236 .

fg:Clinical_Response_to_treatment a owl:ObjectProperty;
  rdfs:label "Response to treatment";
  rdfs:domain fg:Clinical;
  rdfs:isDefinedBy <http://purl.bioontology.org/ontology/SNOMEDCT/182985004>;
  dc:description "The patients' response to the applied treatment regimen.";
  rdfs:range <http://purl.bioontology.org/ontology/SNOMEDCT/182985004> .

fg:Material a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C43376;
  rdfs:label "Material";
  dc:description "Primary biological material obtained directly from a donor or patient through a collection procedure (e.g. biopsy, surgery, blood draw), defining the original anatomical source, sampling timestamp, and pathological state.";
  obo:HSO_0000242 fg:Personal;
  obo:RO_0000056 fg:Clinical .

fg:Material_Material_identifier a owl:DatatypeProperty;
  rdfs:label "Material identifier";
  rdfs:domain fg:Material;
  rdfs:isDefinedBy obo:NCIT_C93400;
  dc:description "A unique proper name or character sequence that identifies this particular material." .

fg:Material_Collected_from_person a owl:ObjectProperty;
  rdfs:label "Collected from person";
  rdfs:domain fg:Material;
  rdfs:isDefinedBy <http://semanticscience.org/resource/SIO_000244>;
  dc:description "Reference to the person from whom this material was collected." .

fg:Material_Belongs_to_diagnosis a owl:ObjectProperty;
  rdfs:label "Belongs to diagnosis";
  rdfs:domain fg:Material;
  rdfs:isDefinedBy <http://semanticscience.org/resource/SIO_000068>;
  dc:description "Reference to a diagnosis c.q. clinical examination of which this material may be a part of. There can be multiple diagnoses when a non-tumor material is reused as reference." .

fg:Material_Sampling_date a owl:DatatypeProperty;
  rdfs:label "Sampling date";
  rdfs:domain fg:Material;
  rdfs:isDefinedBy obo:NCIT_C164024;
  dc:description "The date that a sample was collected or obtained." .

fg:Material_Material_type a owl:ObjectProperty;
  rdfs:label "Material type";
  rdfs:domain fg:Material;
  rdfs:isDefinedBy obo:NCIT_C70713;
  dc:description "The broad biological nature of the collected substance prior to processing (e.g. whole blood, solid tissue, bone marrow, saliva, urine).";
  rdfs:range obo:NCIT_C70699 .

fg:Material_Anatomical_source a owl:ObjectProperty;
  rdfs:label "Anatomical source";
  rdfs:domain fg:Material;
  rdfs:isDefinedBy obo:NCIT_C13717;
  dc:description "The specific organ, anatomical site, or bodily structure of the individual from which the biological material was procured.";
  rdfs:range obo:UBERON_0001062 .

fg:Material_Pathological_state a owl:ObjectProperty;
  rdfs:label "Pathological state";
  rdfs:domain fg:Material;
  rdfs:isDefinedBy obo:NCIT_C28257;
  dc:description "The histological or pathological condition of the procured biological specimen or biofluid (e.g. malignant, benign, non-involved control, premalignant).";
  rdfs:range obo:NCIT_C164617 .

fg:Biospecimens a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C70699;
  rdfs:label "Biospecimens";
  dc:description "A specific physical unit, aliquot, or processed preparation derived from primary material (e.g. FFPE block, frozen tissue section, biofluid aliquot) managed in biobank storage under defined preservation and fixation conditions.";
  obo:RO_0001000 fg:Material .

fg:Biospecimens_Biospecimen_identifier a owl:DatatypeProperty;
  rdfs:label "Biospecimen identifier";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C93400;
  dc:description "A unique proper name or character sequence that identifies this particular biospecimen." .

fg:Biospecimens_Derived_from_material a owl:ObjectProperty;
  rdfs:label "Derived from material";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:RO_0001000;
  dc:description "Identifies the parent biological Material entity from which this biospecimen directly or indirectly originates, either as a physical portion (aliquot) or as a derived fraction (e.g., extracted DNA, serum, tissue section)." .

fg:Biospecimens_Biospecimen_Form a owl:ObjectProperty;
  rdfs:label "Biospecimen Form";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C70713;
  dc:description "The specific physical form, fraction, or analyte derived from the parent material (e.g., extracted genomic DNA, total RNA, serum, cell lysate, or FFPE section) prepared for downstream analysis or sequencing.";
  rdfs:range obo:NCIT_C173496 .

fg:Biospecimens_Percentage_tumor_cells a owl:DatatypeProperty;
  rdfs:label "Percentage tumor cells";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C123556;
  dc:description "The percentage of tumor cells compared to total cells present in this material." .

fg:Biospecimens_Quantity a owl:DatatypeProperty;
  rdfs:label "Quantity";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C25256;
  dc:description "The total count or number of available physical units, aliquots, blocks, or slides representing this specific biospecimen instance." .

fg:Biospecimens_Storage_conditions a owl:ObjectProperty;
  rdfs:label "Storage conditions";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C96145;
  dc:description "The environmental temperature and preservation parameter under which the biospecimen is maintained in the repository.";
  rdfs:range obo:NCIT_C96145 .

fg:Biospecimens_Managing_biobank a owl:ObjectProperty;
  rdfs:label "Managing biobank";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C48800;
  dc:description "The organization or facility that owns, manages, and physically stores this biospecimen or slide, maintaining custody and responsibility for its storage conditions and associated data.";
  rdfs:range <http://hdl.handle.net/21.12110/1.BE90-1C99-5787> .

fg:Biospecimens_Availability a owl:ObjectProperty;
  rdfs:label "Availability";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C25429;
  dc:description "The current operational or inventory status indicating whether the biospecimen is available for research, reserved, depleted, or destroyed.";
  rdfs:range obo:NCIT_C25429 .

fg:Biospecimens_Name_of_fixative a owl:ObjectProperty;
  rdfs:label "Name of fixative";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C128948;
  dc:description "The name of the compound that preserves tissues and cells for microscopic study.";
  rdfs:range obo:NCIT_C498 .

fg:Biospecimens_Embedding_medium a owl:ObjectProperty;
  rdfs:label "Embedding medium";
  rdfs:domain fg:Biospecimens;
  rdfs:isDefinedBy obo:NCIT_C113307;
  dc:description "A material that infiltrates and supports a specimen and preserves its shape and structure for sectioning and microscopy.";
  rdfs:range obo:NCIT_C113307 .

fg:Imaging_study a owl:Class;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#ImagingStudy>;
  rdfs:label "Imaging study";
  dc:description "A diagnostic, clinical, or research imaging procedure comprising one or more imaging series (e.g. radiological scans such as CT/MRI or digital pathology whole slide images) acquired for a subject within a common clinical or study context.";
  obo:BFO_0000051 fg:Imaging_Series;
  obo:RO_0000056 fg:Clinical .

fg:Imaging_study_Imaging_study_identifier a owl:DatatypeProperty;
  rdfs:label "Imaging study identifier";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy obo:NCIT_C164493;
  dc:description "The user- or equipment-generated identifier of an instance of a study entity." .

fg:Imaging_study_Belongs_to_person a owl:ObjectProperty;
  rdfs:label "Belongs to person";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy obo:NCIT_C164337;
  dc:description "Reference to the person whom this imaging study is about." .

fg:Imaging_study_Belongs_to_diagnosis a owl:ObjectProperty;
  rdfs:label "Belongs to diagnosis";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy <http://semanticscience.org/resource/SIO_000068>;
  dc:description "Reference to the specific clinical examination, diagnosis, or disease timepoint during which this imaging study was indicated or evaluated." .

fg:Imaging_study_Study_date a owl:DatatypeProperty;
  rdfs:label "Study date";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy obo:NCIT_C69208;
  dc:description "The date on which a study began." .

fg:Imaging_study_Imaging_procedure a owl:ObjectProperty;
  rdfs:label "Imaging procedure";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy obo:NCIT_C17369;
  dc:description "An imaging procedure as defined by SNOMED CT, representing a specific diagnostic or acquisition procedure (e.g., 'CT of breast', 'MRI of head', or 'Whole Slide Imaging'), rather than the general modality or technique alone. The general modality or technique (e.g., 'CT', 'MR', 'SM') is captured separately in the 'Imaging modality' field.";
  rdfs:range <http://snomed.info/id/15220000> .

fg:Imaging_study_Reason_for_imaging_procedure a owl:ObjectProperty;
  rdfs:label "Reason for imaging procedure";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy obo:NCIT_C69216;
  dc:description "The clinical or research rationale for performing the imaging procedure. This field captures why the procedure was indicated for the patient, such as screening, diagnosis, treatment planning, or research purposes. It should express the intent or medical reason, not the technical details of the procedure itself.";
  rdfs:range <http://snomed.info/id/138875005> .

fg:Imaging_study_Series_count a owl:DatatypeProperty;
  rdfs:label "Series count";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy obo:NCIT_C164492;
  dc:description "The total number of image series contained within this imaging study." .

fg:Imaging_study_Images_count a owl:DatatypeProperty;
  rdfs:label "Images count";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy obo:NCIT_C164540;
  dc:description "The total number of individual image instances or frames comprising this imaging study." .

fg:Imaging_study_Affiliated_institution a owl:ObjectProperty;
  rdfs:label "Affiliated institution";
  rdfs:domain fg:Imaging_study;
  rdfs:isDefinedBy obo:NCIT_C25412;
  dc:description "The organisation or institution responsible for performing the imaging study.";
  rdfs:range <http://semanticscience.org/resource/SIO_000688> .

fg:Slide_preparation_assay a owl:Class;
  rdfs:isDefinedBy obo:OBI_0000070;
  rdfs:label "Slide preparation assay";
  dc:description "A laboratory protocol for preparing, sectioning, and staining biological specimens on glass slides (e.g. histological, special staining, or immunohistochemistry assays) prior to whole slide imaging or microscopic evaluation.";
  obo:OBI_0000293 fg:Biospecimens;
  <http://semanticscience.org/resource/SIO_000248> fg:Imaging_study .

fg:Slide_preparation_assay_Assay_identifier a owl:DatatypeProperty;
  rdfs:label "Assay identifier";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0001979>;
  dc:description "An assay identifier is an identifier that identifies some assay (analysis)." .

fg:Slide_preparation_assay_Assay_type a owl:ObjectProperty;
  rdfs:label "Assay type";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy obo:NCIT_C189101;
  dc:description "The specific type of laboratory test or analytical procedure performed on a bio-specimen mounted on a glass slide. It defines the staining or labeling technique applied to the specimen to reveal specific structural, molecular, or cellular features.";
  rdfs:range obo:NCIT_C23043 .

fg:Slide_preparation_assay_Belongs_to_biospecimen a owl:ObjectProperty;
  rdfs:label "Belongs to biospecimen";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy obo:OBI_0000293;
  dc:description "Reference to the biospecimen (e.g. FFPE block, slide) that was the physical input to this slide preparation assay." .

fg:Slide_preparation_assay_Precedes_the_study a owl:ObjectProperty;
  rdfs:label "Precedes the study";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy <http://semanticscience.org/resource/SIO_000248>;
  dc:description "Reference to the subsequent imaging study or digital whole-slide scanning event for which this prepared slide serves as the direct physical input." .

fg:Slide_preparation_assay_Biomarker_type a owl:ObjectProperty;
  rdfs:label "Biomarker type";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy obo:NCIT_C201359;
  dc:description "A classification of the type of biomolecule or biological component that the assay targets, labels, or detects. It characterizes whether the biomarker is, for example, a protein, nucleic acid, carbohydrate, lipid, or inorganic substance.";
  rdfs:range obo:OPMI_0000452 .

fg:Slide_preparation_assay_Section_thickness a owl:DatatypeProperty;
  rdfs:label "Section thickness";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy obo:NCIT_C176286;
  dc:description "A measurement of the thickness of a sectioned slice (of tissue or mineral or other substance), expressed in micrometers (µm)." .

fg:Slide_preparation_assay_Biomarker_spatial_localization a owl:ObjectProperty;
  rdfs:label "Biomarker spatial localization";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy obo:GO_0051641;
  dc:description "The subcellular or structural location within a tissue or cell where the biomarker is expressed or detected.";
  rdfs:range obo:GO_0110165 .

fg:Slide_preparation_assay_Pathogen_type a owl:ObjectProperty;
  rdfs:label "Pathogen type";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy <https://w3id.org/evorao/pathogenType>;
  dc:description "Identification of the specific type of pathogen among the listed categories e.g. 'Virus','Viroid','Bacterium'...";
  rdfs:range obo:NCIT_C80324 .

fg:Slide_preparation_assay_Dye_name a owl:ObjectProperty;
  rdfs:label "Dye name";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy <http://snomed.info/id/703857004>;
  dc:description "The neutral or synthetic colored substance used for staining specific tissues or cellular components.";
  rdfs:range <http://snomed.info/id/703857004> .

fg:Slide_preparation_assay_Counter_labeling a owl:ObjectProperty;
  rdfs:label "Counter labeling";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy <http://snomed.info/id/703857004>;
  dc:description "The counter-labeling technique used to highlight specific cellular or tissue structures, serving as a complementary method to the primary labeling for analysis";
  rdfs:range <http://snomed.info/id/703857004> .

fg:Slide_preparation_assay_Antibody_name a owl:ObjectProperty;
  rdfs:label "Antibody name";
  rdfs:domain fg:Slide_preparation_assay;
  rdfs:isDefinedBy obo:XCO_0000194;
  dc:description "The vendor-stated name of an antibody used to detect and visualize the presence of an antigen.";
  rdfs:range obo:XCO_0000194 .

fg:Sample_preparation a owl:Class;
  rdfs:isDefinedBy obo:OBI_0001902;
  rdfs:label "Sample preparation";
  dc:description "The pre-analytical laboratory procedure used to extract, isolate, and prepare nucleic acids into sequencing libraries, including target enrichment, molecular barcoding, and library quality control.";
  obo:OBI_0000293 fg:Biospecimens .

fg:Sample_preparation_Sampleprep_identifier a owl:DatatypeProperty;
  rdfs:label "Sampleprep identifier";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy obo:NCIT_C132299;
  dc:description "A unique proper name or character sequence that identifies this particular sample preparation." .

fg:Sample_preparation_Belongs_to_biospecimen a owl:ObjectProperty;
  rdfs:label "Belongs to biospecimen";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy obo:OBI_0000293;
  dc:description "Reference to the source biospecimen from which this sample was prepared." .

fg:Sample_preparation_Input_amount a owl:DatatypeProperty;
  rdfs:label "Input amount";
  sio:SIO_000074 obo:UO_0000024;
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/role#AFRL_0000010>;
  dc:description "Amount of input material in nanogram (ng)." .

fg:Sample_preparation_Library_preparation_kit a owl:ObjectProperty;
  rdfs:label "Library preparation kit";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy obo:GENEPIO_0000085;
  dc:description "Pre-filled, ready-to-use reagent cartridges intented to improve chemistry, cluster density and read length as well as improve quality (Q) scores for this sample. Reagent components are encoded to interact with the sequencing system to validate compatibility with user-defined applications.";
  rdfs:range obo:GENEPIO_0000081 .

fg:Sample_preparation_PCR_free a owl:DatatypeProperty;
  rdfs:label "PCR free";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy obo:NCIT_C17003;
  dc:description "Indicates whether a polymerase chain reaction (PCR) was used to prepare this sample. PCR is a method for amplifying a DNA base sequence using multiple rounds of heat denaturation of the DNA and annealing of oligonucleotide primers complementary to flanking regions in the presence of a heat-stable polymerase." .

fg:Sample_preparation_Target_enrichment_kit a owl:ObjectProperty;
  rdfs:label "Target enrichment kit";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy obo:NCIT_C154307;
  dc:description "Indicates which target enrichment kit was used to prepare this sample. Target enrichment is a pre-sequencing DNA preparation step where DNA sequences are either directly amplified (amplicon or multiplex PCR-based) or captured (hybrid capture-based) in order to only focus on specific regions of a genome or DNA sample.";
  rdfs:range obo:GENEPIO_0000081 .

fg:Sample_preparation_Fully_sequenced_genes a owl:ObjectProperty;
  rdfs:label "Fully sequenced genes";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy obo:NCIT_C16612;
  dc:description "List of genes where the entire coding sequence (all exons) was targeted and sequenced.";
  rdfs:range obo:NCIT_C16612 .

fg:Sample_preparation_Partially_sequenced_genes a owl:ObjectProperty;
  rdfs:label "Partially sequenced genes";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy obo:NCIT_C16612;
  dc:description "List of genes where only specific regions or hotspots (selected exons/codons) were targeted and sequenced.";
  rdfs:range obo:NCIT_C16612 .

fg:Sample_preparation_UMIs_present a owl:DatatypeProperty;
  rdfs:label "UMIs present";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy <http://www.ebi.ac.uk/efo/EFO_0010199>;
  dc:description "Indicates whether any unique molecular identifiers (UMIs) are present. An UMI barcode is a short nucleotide sequence that is used to identify reads originating from an individual mRNA molecule." .

fg:Sample_preparation_Intended_insert_size a owl:DatatypeProperty;
  rdfs:label "Intended insert size";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy <https://w3id.org/fair-genomes/resource/FG_0000001>;
  dc:description "In paired-end sequencing, the DNA between the adapter sequences is the insert. The length of this sequence is known as the insert size, not to be confused with the inner distance between reads. So, fragment length equals read adapter length (2x) plus insert size, and insert size equals read lenght (2x) plus inner distance." .

fg:Sample_preparation_Intended_read_length a owl:DatatypeProperty;
  rdfs:label "Intended read length";
  rdfs:domain fg:Sample_preparation;
  rdfs:isDefinedBy obo:NCIT_C153362;
  dc:description "The number of nucleotides intended to be ordered from each side of a nucleic acid fragment obtained after the completion of a sequencing process." .

fg:Sequencing a owl:Class;
  rdfs:isDefinedBy <http://edamontology.org/topic_3168>;
  rdfs:label "Sequencing";
  dc:description "Technical execution and instrument run parameters of a high-throughput sequencing assay, including sequencer platform, read metrics, coverage depth, and sequencing quality control statistics.";
  <http://semanticscience.org/resource/SIO_001220> fg:Sample_preparation .

fg:Sequencing_Sequencing_identifier a owl:DatatypeProperty;
  rdfs:label "Sequencing identifier";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:NCIT_C171337;
  dc:description "A unique proper name or character sequence that identifies this particular nucleic acid sequencing assay." .

fg:Sequencing_Belongs_to_sample_preparation a owl:ObjectProperty;
  rdfs:label "Belongs to sample preparation";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:NCIT_C25683;
  dc:description "Reference to the prepared sample, i.e. the source that was sequenced." .

fg:Sequencing_Sequencing_date a owl:DatatypeProperty;
  rdfs:label "Sequencing date";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:GENEPIO_0000069;
  dc:description "Date on which this sequencing assay was performed." .

fg:Sequencing_Sequencing_platform a owl:ObjectProperty;
  rdfs:label "Sequencing platform";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:GENEPIO_0000071;
  dc:description "The used sequencing platform (i.e. brand, name of a company that produces sequencer equipment).";
  rdfs:range obo:GENEPIO_0000071 .

fg:Sequencing_Sequencing_instrument_model a owl:ObjectProperty;
  rdfs:label "Sequencing instrument model";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:GENEPIO_0001921;
  dc:description "The used product name and model number of a manufacturer's genomic (dna) sequencer.";
  rdfs:range obo:GENEPIO_0001921 .

fg:Sequencing_Sequencing_method a owl:ObjectProperty;
  rdfs:label "Sequencing method";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:FIX_0000704;
  dc:description "Method used to determine the order of bases in a nucleic acid sequence.";
  rdfs:range obo:NCIT_C17565 .

fg:Sequencing_Median_read_depth a owl:DatatypeProperty;
  rdfs:label "Median read depth";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:NCIT_C155320;
  dc:description "The median number of times a particular locus (site, nucleotide, amplicon, region) was sequenced." .

fg:Sequencing_Observed_read_length a owl:DatatypeProperty;
  rdfs:label "Observed read length";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:NCIT_C153362;
  dc:description "The number of nucleotides successfully ordered from each side of a nucleic acid fragment obtained after the completion of a sequencing process." .

fg:Sequencing_Observed_insert_size a owl:DatatypeProperty;
  rdfs:label "Observed insert size";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy <https://w3id.org/fair-genomes/resource/FG_0000002>;
  dc:description "In paired-end sequencing, the DNA between the adapter sequences is the insert. The length of this sequence is known as the insert size, not to be confused with the inner distance between reads. So, fragment length equals read adapter length (2x) plus insert size, and insert size equals read lenght (2x) plus inner distance." .

fg:Sequencing_Percentage_Q30 a owl:DatatypeProperty;
  rdfs:label "Percentage Q30";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy obo:GENEPIO_0000089;
  dc:description "Percentage of reads with a Phred quality score over 30, which indicates less than a 1/1000 chance that the base was called incorrectly." .

fg:Sequencing_Percentage_TR20 a owl:DatatypeProperty;
  rdfs:label "Percentage TR20";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy <https://w3id.org/fair-genomes/resource/FG_0000003>;
  dc:description "Percentage of the target sequence on which 20 or more unique reads were successfully mapped." .

fg:Sequencing_Other_quality_metrics a owl:DatatypeProperty;
  rdfs:label "Other quality metrics";
  rdfs:domain fg:Sequencing;
  rdfs:isDefinedBy <http://edamontology.org/data_3914>;
  dc:description "Other NGS quality control metrics, including but not limited to (i) sequencer metrics such as yield, error rate, density (K/mm2), cluster PF (%) and phas/prephas (%), (ii) alignment metrics such as QM insert size, GC content, QM duplicated reads (%), QM error rate, uniformity/evenness of coverage and maternal cell contamination, and (iii) variant call metrics such as number of SNVs/CNVs/SVs called, number of missense/nonsense variants, common variants (%), unique variants (%), gender match and trio inheritance check." .

fg:Analysis a owl:Class;
  rdfs:isDefinedBy <http://edamontology.org/operation_2945>;
  rdfs:label "Analysis";
  dc:description "Computational and bioinformatic processing workflows applied to primary sequencing data, including reference genome alignment, variant calling algorithms, standard pipeline guidelines, and stored output file formats.";
  <http://semanticscience.org/resource/SIO_000253> fg:Sequencing .

fg:Analysis_Analysis_identifier a owl:DatatypeProperty;
  rdfs:label "Analysis identifier";
  rdfs:domain fg:Analysis;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0001979>;
  dc:description "A unique proper name or character sequence that identifies this particular analysis." .

fg:Analysis_Belongs_to_sequencing a owl:ObjectProperty;
  rdfs:label "Belongs to sequencing";
  rdfs:domain fg:Analysis;
  rdfs:isDefinedBy obo:NCIT_C25683;
  dc:description "Reference to the sequencing that was performed, i.e. the source on which this analysis was based." .

fg:Analysis_Data_formats_stored a owl:ObjectProperty;
  rdfs:label "Data formats stored";
  rdfs:domain fg:Analysis;
  rdfs:isDefinedBy obo:NCIT_C142494;
  dc:description "Which data file formats (i.e. defined ways or layouts of representing and structuring data in a computer file, blob, string, message, or elsewhere) are stored and potentially available.";
  rdfs:range <http://edamontology.org/format_1915> .

fg:Analysis_Algorithms_used a owl:DatatypeProperty;
  rdfs:label "Algorithms used";
  rdfs:domain fg:Analysis;
  rdfs:isDefinedBy obo:NCIT_C16275;
  dc:description "Any used problem-solving procedures implemented in software to be executed by a computer." .

fg:Analysis_Reference_genome_used a owl:ObjectProperty;
  rdfs:label "Reference genome used";
  rdfs:domain fg:Analysis;
  rdfs:isDefinedBy <http://edamontology.org/data_2340>;
  dc:description "The specific build of the human genome used as reference for sequence alignment and variant calling.";
  rdfs:range <http://edamontology.org/data_2787> .

fg:Analysis_Bioinformatic_protocol_used a owl:DatatypeProperty;
  rdfs:label "Bioinformatic protocol used";
  rdfs:domain fg:Analysis;
  rdfs:isDefinedBy <http://edamontology.org/data_2531>;
  dc:description "A human-readable collection of information about about how a scientific experiment or analysis was carried out that results in a specific set of data or results used for further analysis or to test a specific hypothesis." .

fg:Imaging_series a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C69225;
  rdfs:label "Imaging series";
  dc:description "Common metadata and technical characteristics for a coherent series of biomedical image instances acquired using a single equipment, coordinate frame, and imaging modality within an imaging study.";
  obo:RO_0000053 <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>,
    <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>, <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>,
    <https://w3id.org/fair-genomes/ontology/Digital_radiography_(DX)>, <https://w3id.org/fair-genomes/ontology/Digital_mammography_(MG)>,
    <https://w3id.org/fair-genomes/ontology/Ultrasound_imaging_(US)> .

fg:Imaging_series_Series_instance_identifier a owl:DatatypeProperty;
  rdfs:label "Series instance identifier";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C69219;
  dc:description "A unique identifier for series of images." .

fg:Imaging_series_Belongs_to_imaging_study a owl:ObjectProperty;
  rdfs:label "Belongs to imaging study";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C164493;
  dc:description "Parent study context." .

fg:Imaging_series_Images_count a owl:DatatypeProperty;
  rdfs:label "Images count";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C164540;
  dc:description "The total number of discrete image instances, slices, or frames contained within this imaging series." .

fg:Imaging_series_Imaging_modality a owl:ObjectProperty;
  rdfs:label "Imaging modality";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C17369;
  dc:description "Any technology or method that aids in the visualization of any biological process, cell, tissue or organ for use in screening, diagnosis, surgical procedures or therapy.";
  rdfs:range <http://purl.bioontology.org/ontology/SNOMEDCT/360037004> .

fg:Imaging_series_Series_date a owl:DatatypeProperty;
  rdfs:label "Series date";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C68616;
  dc:description "The date on which a series began." .

fg:Imaging_series_Body_region a owl:ObjectProperty;
  rdfs:label "Body region";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C12680;
  dc:description "The specific anatomical region, body part, or organ targeted by this imaging series.";
  rdfs:range <http://snomed.info/id/52530000> .

fg:Imaging_series_Laterality a owl:ObjectProperty;
  rdfs:label "Laterality";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C25185;
  dc:description "The side of the body or paired organ being examined (e.g. Left, Right, Bilateral, Unilateral).";
  rdfs:range <http://snomed.info/id/106233006> .

fg:Imaging_series_Imaging_device a owl:ObjectProperty;
  rdfs:label "Imaging device";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C19747;
  dc:description "A device for producing a representation or picture, usually of a part of the body, to aid in diagnosis and evaluation.";
  rdfs:range <http://snomed.info/id/314789007> .

fg:Imaging_series_Manufacturer_of_imaging_device a owl:ObjectProperty;
  rdfs:label "Manufacturer of imaging device";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C25392;
  dc:description "A person, enterprise, or entity that produces imaging device.";
  rdfs:range obo:OBI_0000835 .

fg:Imaging_series_Software_version a owl:ObjectProperty;
  rdfs:label "Software version";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C111093;
  dc:description "A form or variant of software; one of a sequence of copies of a software program, each incorporating new modifications.";
  rdfs:range <http://snomed.info/id/706687001> .

fg:Imaging_series_Color_space a owl:ObjectProperty;
  rdfs:label "Color space";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C37927;
  dc:description "The photometric interpretation of pixel data that defines the type of colour or greyscale encoding used in the image (e.g., MONOCHROME2, RGB, YBR_FULL). Corresponds to DICOM tag (0028,0004).";
  rdfs:range <https://w3id.org/valuesets/ColorSpaceEnum> .

fg:Imaging_series_Pixel_spacing a owl:DatatypeProperty;
  rdfs:label "Pixel spacing";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C45786;
  dc:description "Physical distance between the centres of adjacent pixels in the image space, specified as row and column spacing. Expressed in millimetres (mm) according to DICOM attribute (0028,0030)." .

fg:Imaging_series_Image_type a owl:ObjectProperty;
  rdfs:label "Image type";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C69268;
  dc:description "A classification of the image based on the imaging modality and acquisition characteristics. It specifies the type of image produced during the scan (e.g., T1-weighted MRI, T2-weighted MRI, CT attenuation image, PET uptake image).";
  rdfs:range <http://snomed.info/id/363679005> .

fg:Imaging_series_File_format a owl:ObjectProperty;
  rdfs:label "File format";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:MS_1001459;
  dc:description "The digital format used to encode and store an imaging file.";
  rdfs:range obo:MS_1001459 .

fg:Imaging_series_File_size a owl:DatatypeProperty;
  rdfs:label "File size";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C171192;
  dc:description "The size of the file in MB." .

fg:Imaging_series_Image_width a owl:DatatypeProperty;
  rdfs:label "Image width";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002468>;
  dc:description "Number of pixels in one row of the image, corresponding to the DICOM attribute Columns (0028,0011)." .

fg:Imaging_series_Image_height a owl:DatatypeProperty;
  rdfs:label "Image height";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002467>;
  dc:description "Number of pixels in one column of the image, corresponding to the DICOM attribute Rows (0028,0010)." .

fg:Imaging_series_Image_depth a owl:DatatypeProperty;
  rdfs:label "Image depth";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C69267;
  dc:description "The number of distinct image planes captured during acquisition. For WSI, this represents the number of focal planes (Z-stack levels). For CT, MRI, and PET, it corresponds to the number of cross-sectional slices or frames. For DX and MG, this value is typically 1 (a single 2D projection)." .

fg:Imaging_series_Number_of_channels a owl:DatatypeProperty;
  rdfs:label "Number of channels";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#SamplesPerPixel>;
  dc:description "The number of distinct data channels stored in each pixel of the image. Channels may represent color components (e.g., RGB), grayscale intensity, or modality-specific signal dimensions." .

fg:Imaging_series_Channel_resolution a owl:DatatypeProperty;
  rdfs:label "Channel resolution";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#SignificantBits>;
  dc:description "The number of bits used to represent the stored value of each pixel channel. In DICOM, this corresponds to tag (0028,0101)." .

fg:Imaging_series_Compression_method a owl:DatatypeProperty;
  rdfs:label "Compression method";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C64347;
  dc:description "Indicates whether the image was lossy-compressed and which method was used, based on DICOM tags (0028,2110) and (0028,2114)." .

fg:Imaging_series_Annotations_available a owl:DatatypeProperty;
  rdfs:label "Annotations available";
  rdfs:domain fg:Imaging_series;
  rdfs:isDefinedBy obo:NCIT_C44272;
  dc:description "Indicates whether annotation data associated with the image (e.g., regions of interest, labels, markup, or segmentation overlays) are present and accessible." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)> a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C165215;
  rdfs:label "Whole slide imaging (WSI)";
  dc:description "Modality-specific series metadata for high-resolution digital pathology whole slide images, capturing optical scanning modes, lens magnification, illumination parameters, and focal z-stacking." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_WSI_identifier>
  a owl:DatatypeProperty;
  rdfs:label "WSI identifier";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C69219;
  dc:description "A unique identifier for WSI series of images." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Z_stacking> a owl:ObjectProperty;
  rdfs:label "Z_stacking";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C182016;
  dc:description "A digital image processing method which combines multiple images taken at different focal distances to create a composite image with a greater depth of field than is possible for a single image.";
  rdfs:range obo:NCIT_C182016 .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Objective_lens_magnification>
  a owl:DatatypeProperty;
  rdfs:label "Objective lens magnification";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002226>;
  dc:description "The objective lens magnification used for the acquisition of whole slide images, expressed as a dimensionless optical magnification factor (e.g., 10×, 20×, 40×). This refers only to the lens magnification and not the final stored image encoded by the spatial resolution attribute." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Illumination_method>
  a owl:ObjectProperty;
  rdfs:label "Illumination method";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:FBbi_00000268;
  dc:description "The method of optical illumination used to illuminate the specimen during scanning (e.g., brightfield, darkfield, fluorescence, phase contrast).";
  rdfs:range obo:FBbi_00000268 .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Illumination_wavelength>
  a owl:DatatypeProperty;
  rdfs:label "Illumination wavelength";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://snomed.info/id/246522008>;
  dc:description "Nominal wavelength of the illuminator expressed in nanometres (nm)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Scanning_operation_mode>
  a owl:ObjectProperty;
  rdfs:label "Scanning operation mode";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://snomed.info/id/246363001>;
  dc:description "The scanning procedure used to digitize a glass slide. This attribute does not describe the capabilities of the scanner used for digitization.";
  rdfs:range <http://snomed.info/id/246363001> .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Tissue_scan_area>
  a owl:DatatypeProperty;
  rdfs:label "Tissue scan area";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/process#AFP_0003804>;
  dc:description "The area of the tissue region that was scanned, expressed in square millimetres (mm²)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Number_of_focal_planes>
  a owl:DatatypeProperty;
  rdfs:label "Number of focal planes";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C102516;
  dc:description "Number of focal planes along the vertical z-axis used for multiple and extended z-stacking methods." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Distance_between_focal_planes>
  a owl:DatatypeProperty;
  rdfs:label "Distance between focal planes";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/quality#AFQ_0000032>;
  dc:description "Distance between acquisition focal planes given in micrometers (µm)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Pyramid_levels>
  a owl:DatatypeProperty;
  rdfs:label "Pyramid levels";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0001619>;
  dc:description "The number of specific resolution levels of an image pyramid." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Colour_(ICC)_profile>
  a owl:DatatypeProperty;
  rdfs:label "Colour (ICC) profile";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#PhotometricInterpretation>;
  dc:description "A standardised colour profile defined by the International Color Consortium (ICC) that specifies how colours in an image should be interpreted to ensure consistent colour rendering across devices (e.g. sRGB or Gray Gamma 1.8/2.2, GSDF)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Assay_identifier>
  a owl:ObjectProperty;
  rdfs:label "Assay identifier";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0001979>;
  dc:description "An assay identifier is an identifier that identifies some assay (analysis)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Compression_quality_label>
  a owl:DatatypeProperty;
  rdfs:label "Compression quality label";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/process#AFP_0002843>;
  dc:description "A vendor-specific indicator describing the applied level or strength of lossy compression (e.g., quality level or percentage), not defined in DICOM but used in some WSI formats to express perceived compression quality." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Series_instance_identifier>
  a owl:DatatypeProperty;
  rdfs:label "Series instance identifier";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C69219;
  dc:description "A unique identifier for series of images." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Belongs_to_imaging_study>
  a owl:ObjectProperty;
  rdfs:label "Belongs to imaging study";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C164493;
  dc:description "Parent study context." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Images_count> a
    owl:DatatypeProperty;
  rdfs:label "Images count";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C164540;
  dc:description "The total number of discrete image instances, slices, or frames contained within this imaging series." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Imaging_modality>
  a owl:ObjectProperty;
  rdfs:label "Imaging modality";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C17369;
  dc:description "Any technology or method that aids in the visualization of any biological process, cell, tissue or organ for use in screening, diagnosis, surgical procedures or therapy.";
  rdfs:range <http://purl.bioontology.org/ontology/SNOMEDCT/360037004> .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Series_date> a owl:DatatypeProperty;
  rdfs:label "Series date";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C68616;
  dc:description "The date on which a series began." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Body_region> a owl:ObjectProperty;
  rdfs:label "Body region";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C12680;
  dc:description "The specific anatomical region, body part, or organ targeted by this imaging series.";
  rdfs:range <http://snomed.info/id/52530000> .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Laterality> a owl:ObjectProperty;
  rdfs:label "Laterality";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C25185;
  dc:description "The side of the body or paired organ being examined (e.g. Left, Right, Bilateral, Unilateral).";
  rdfs:range <http://snomed.info/id/106233006> .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Imaging_device>
  a owl:ObjectProperty;
  rdfs:label "Imaging device";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C19747;
  dc:description "A device for producing a representation or picture, usually of a part of the body, to aid in diagnosis and evaluation.";
  rdfs:range <http://snomed.info/id/314789007> .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Manufacturer_of_imaging_device>
  a owl:ObjectProperty;
  rdfs:label "Manufacturer of imaging device";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C25392;
  dc:description "A person, enterprise, or entity that produces imaging device.";
  rdfs:range obo:OBI_0000835 .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Software_version>
  a owl:ObjectProperty;
  rdfs:label "Software version";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C111093;
  dc:description "A form or variant of software; one of a sequence of copies of a software program, each incorporating new modifications.";
  rdfs:range <http://snomed.info/id/706687001> .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Color_space> a owl:ObjectProperty;
  rdfs:label "Color space";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C37927;
  dc:description "The photometric interpretation of pixel data that defines the type of colour or greyscale encoding used in the image (e.g., MONOCHROME2, RGB, YBR_FULL). Corresponds to DICOM tag (0028,0004).";
  rdfs:range <https://w3id.org/valuesets/ColorSpaceEnum> .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Pixel_spacing> a
    owl:DatatypeProperty;
  rdfs:label "Pixel spacing";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C45786;
  dc:description "Physical distance between the centres of adjacent pixels in the image space, specified as row and column spacing. Expressed in millimetres (mm) according to DICOM attribute (0028,0030)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Image_type> a owl:ObjectProperty;
  rdfs:label "Image type";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C69268;
  dc:description "A classification of the image based on the imaging modality and acquisition characteristics. It specifies the type of image produced during the scan (e.g., T1-weighted MRI, T2-weighted MRI, CT attenuation image, PET uptake image).";
  rdfs:range <http://snomed.info/id/363679005> .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_File_format> a owl:ObjectProperty;
  rdfs:label "File format";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:MS_1001459;
  dc:description "The digital format used to encode and store an imaging file.";
  rdfs:range obo:MS_1001459 .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_File_size> a owl:DatatypeProperty;
  rdfs:label "File size";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C171192;
  dc:description "The size of the file in MB." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Image_width> a owl:DatatypeProperty;
  rdfs:label "Image width";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002468>;
  dc:description "Number of pixels in one row of the image, corresponding to the DICOM attribute Columns (0028,0011)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Image_height> a
    owl:DatatypeProperty;
  rdfs:label "Image height";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <http://purl.allotrope.org/ontologies/result#AFR_0002467>;
  dc:description "Number of pixels in one column of the image, corresponding to the DICOM attribute Rows (0028,0010)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Image_depth> a owl:DatatypeProperty;
  rdfs:label "Image depth";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C69267;
  dc:description "The number of distinct image planes captured during acquisition. For WSI, this represents the number of focal planes (Z-stack levels). For CT, MRI, and PET, it corresponds to the number of cross-sectional slices or frames. For DX and MG, this value is typically 1 (a single 2D projection)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Number_of_channels>
  a owl:DatatypeProperty;
  rdfs:label "Number of channels";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#SamplesPerPixel>;
  dc:description "The number of distinct data channels stored in each pixel of the image. Channels may represent color components (e.g., RGB), grayscale intensity, or modality-specific signal dimensions." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Channel_resolution>
  a owl:DatatypeProperty;
  rdfs:label "Channel resolution";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#SignificantBits>;
  dc:description "The number of bits used to represent the stored value of each pixel channel. In DICOM, this corresponds to tag (0028,0101)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Compression_method>
  a owl:DatatypeProperty;
  rdfs:label "Compression method";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C64347;
  dc:description "Indicates whether the image was lossy-compressed and which method was used, based on DICOM tags (0028,2110) and (0028,2114)." .

<https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)_Annotations_available>
  a owl:DatatypeProperty;
  rdfs:label "Annotations available";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Whole_slide_imaging_(WSI)>;
  rdfs:isDefinedBy obo:NCIT_C44272;
  dc:description "Indicates whether annotation data associated with the image (e.g., regions of interest, labels, markup, or segmentation overlays) are present and accessible." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)> a owl:Class;
  rdfs:isDefinedBy obo:NCIT_C17204;
  rdfs:label "Computed tomography (CT)";
  dc:description "Modality-specific series metadata for computed tomography acquisitions, capturing X-ray tube exposure parameters, spiral pitch, reconstruction convolution kernels, and slice geometry." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_CT_identifier> a
    owl:DatatypeProperty;
  rdfs:label "CT identifier";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C69219;
  dc:description "A unique identifier for CT series of images." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Tube_voltage_(kVp)>
  a owl:DatatypeProperty;
  rdfs:label "Tube voltage (kVp)";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C48432;
  dc:description "The peak accelerating voltage applied in an X-ray tube between the cathode and anode, corresponding to DICOM tag (0018,0060)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_X_Ray_tube_current_(mA)>
  a owl:DatatypeProperty;
  rdfs:label "X_Ray tube current (mA)";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C69233;
  dc:description "The value of the electrical current applied to an X-ray tube (DICOM tag (0018,1151))." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Exposure_time_(ms)>
  a owl:DatatypeProperty;
  rdfs:label "Exposure time (ms)";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C69233;
  dc:description "The cumulative time a subject was exposed to X-rays during image acquisition. Corresponds to DICOM tag (0018,1150)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Spiral_pitch_factor>
  a owl:DatatypeProperty;
  rdfs:label "Spiral pitch factor";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C164623;
  dc:description "Ratio of the distance that the table moves during a complete revolution of the source around the gantry orbit, to the width of the total collimation over the area of active x-ray detection (DICOM tag (0018,9311))." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Filter_type> a owl:DatatypeProperty;
  rdfs:label "Filter type";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy <https://w3id.org/reproduceme#FilterType>;
  dc:description "Specifies the type of X-ray beam–shaping filter used during image acquisition (e.g., body, head, bowtie, wedge). Corresponds to DICOM tag (0018,1160)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Convolution_kernel>
  a owl:DatatypeProperty;
  rdfs:label "Convolution kernel";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C41832;
  dc:description "An algorithm used to reconstruct imaging data. Convolution kernels can be used to filter images to smooth them and reduce noise or to enhance edges or other image features. Corresponds to DICOM tag (0018,1210)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Field_of_view> a
    owl:DatatypeProperty;
  rdfs:label "Field of view";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C74298;
  dc:description "The physical size of the anatomical region covered in the reconstructed image, expressed in millimetres. Corresponds to DICOM tag (0018,9317)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Slice_thickness>
  a owl:DatatypeProperty;
  rdfs:label "Slice thickness";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C106534;
  dc:description "The dimension between two surfaces of an imaging plane, specified in millimetres (mm). Corresponds to DICOM tag (0018,0050)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Imaging_injection>
  a owl:DatatypeProperty;
  rdfs:label "Imaging injection";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:OBI_0000426;
  dc:description "Administration of CT contrast medium using an injector device. Corresponds to DICOM tag (0018,1040)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Z_axis_spacing> a
    owl:DatatypeProperty;
  rdfs:label "Z_axis spacing";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C156499;
  dc:description "The physical spacing between adjacent CT image slices along the Z-axis, representing the voxel dimension in the slice-selection direction. Expressed in millimetres (mm). Corresponds to DICOM tag (0018,0088)." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Series_instance_identifier>
  a owl:DatatypeProperty;
  rdfs:label "Series instance identifier";
  rdfs:domain <https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)>;
  rdfs:isDefinedBy obo:NCIT_C69219;
  dc:description "A unique identifier for series of images." .

<https://w3id.org/fair-genomes/ontology/Computed_tomography_(CT)_Belongs_to_imaging_study>
  a owl:ObjectProperty;
  rdfs:label "Belongs to imaging study";
