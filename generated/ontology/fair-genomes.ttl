  rdfs:domain <https://w3id.org/fair-genomes/ontology/Magnetic_resonance_(MR)>;
  rdfs:isDefinedBy obo:OBI_0000426;
  dc:description "Administration of MR contrast medium using an injector device. Corresponds to DICOM tag (0018,0010)." .

